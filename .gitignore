# Virtual environment
.venv/

# Environment variables
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# Data (raw/interim/processed thường không nên commit, chỉ giữ cấu trúc thư mục)
data/raw/*
!data/raw/.gitkeep
!data/raw/pdf_text/.gitkeep
!data/raw/pdf_scanned/.gitkeep
!data/raw/docx/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Build artifacts
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
